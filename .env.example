# Keep credentials in your local .env. Never commit that file.
RLMQA_RUNTIME_DIR=runtime/rlm_qa
RLM_PLATFORM_DATA_ROOT=data/platform
RLM_PLATFORM_CACHE_DIR=runtime/platform_docs
RLM_PLATFORM_MAX_INFLIGHT_REQUESTS=64
RLM_TURN_EXECUTION_CONTRACT_ENABLED=true
RLM_CONVERSATION_MEMORY_ENABLED=true
RLM_CONVERSATION_MEMORY_DB=
RLM_CONVERSATION_MEMORY_MAX_CONTEXT_CHARS=12000
RLM_CONVERSATION_MEMORY_MAX_MESSAGES=100
RLM_CONVERSATION_MEMORY_MAX_PENDING_PER_CHAT=8

# Snapshot model names: replace with models supported by your account.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=""
# Credential intentionally empty.
DEEPSEEK_SUBAGENT_MODEL=deepseek-v4-pro
DEEPSEEK_SUBAGENT_API_KEYS=""
# Credential intentionally empty.
DEEPSEEK_FINALIZER_MODEL=deepseek-v4-pro
DEEPSEEK_FINALIZER_API_KEYS=""
# Legacy credential intentionally empty.

GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_GENERATION_MODEL=glm-5.2
GLM_GENERATION_API_KEYS=""
# Credential intentionally empty.
GLM_GENERATION_MAX_CONCURRENCY=3
GLM_GENERATION_MAX_ATTEMPTS=3

GLM_OCR_API_KEY=""
# Credential intentionally empty.
GLM_OCR_API_KEYS=""
# Credential intentionally empty.
GLM_OCR_MODEL=glm-ocr
GLM_OCR_MAX_WORKERS=3
GLM_OCR_MAX_ATTEMPTS=3
GLM_OCR_REQUEST_TIMEOUT_SECONDS=270
GLM_OCR_LEASE_TIMEOUT_SECONDS=300
GLM_OCR_TRANSIENT_COOLDOWN_SECONDS=30
GLM_OCR_RATE_LIMIT_COOLDOWN_SECONDS=60

# Defaults preserve the source snapshot configuration.
# To try the historical accepted variant, choose one_pass and compact.
RLM_MAP_EXECUTION_MODE=staged
RLM_REDUCE_CONTEXT_MODE=expanded
RLM_BATCH_MAX_WORKERS=4
RLM_MAX_DEEP_PACKS=8
RLM_FALLBACK_EVIDENCE_PER_PACK=5
RLM_SUBAGENT_MAX_RETRIES=1
RLM_KEY_COOLDOWN_SECONDS=30
RLM_KEY_LEASE_TIMEOUT_SECONDS=120
RLM_KEY_MAX_FAILURES_BEFORE_DEAD=3
RLM_MAX_TIMEOUT_SECONDS=300
RLM_MAX_ERRORS=20
RLM_REQUEST_TIMEOUT_SECONDS=60

RLM_EVIDENCE_SIMPLE_LIMIT=3
RLM_EVIDENCE_SUMMARY_LIMIT=10
RLM_EVIDENCE_DEFAULT_LIMIT=10
RLM_EVIDENCE_DETAIL_LIMIT=20
RLM_EVIDENCE_MULTI_PER_DOC=3
RLM_EVIDENCE_MULTI_GLOBAL=20
